# Copiar a .env y ajustar:  cp .env.example .env
# Todas las variables tienen un valor por defecto razonable en app/config.py.

# ---------------------------------------------------------------- General
APP_ENV=production              # production oculta /docs
LOG_LEVEL=INFO
DEMO_UI_ENABLED=true            # interfaz de demo en /demo (desactivar en producción)
HTTP_PORT=8080                  # puerto publicado por nginx en el host

# ---------------------------------------------------------------- Escala de la API
API_REPLICAS=2                  # contenedores de la API detrás de nginx
WEB_CONCURRENCY=2               # procesos por contenedor (≈ núcleos disponibles / réplicas)

# ---------------------------------------------------------------- Modelo de lenguaje
LLM_PROVIDER=ollama             # ollama | vllm  (vllm requiere: docker compose --profile vllm up -d)
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=bge-m3       # multilingüe, muy bueno en español
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=8           # generaciones simultáneas por modelo en Ollama

# vLLM (servidor de producción multi-GPU, API compatible con OpenAI)
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_API_KEY=cambiar-esta-clave-larga-y-aleatoria
VLLM_TENSOR_PARALLEL_SIZE=1     # GPUs por réplica del modelo (8B: 1, 70B: 4 u 8)
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=256           # secuencias en paralelo (continuous batching)
HF_TOKEN=                       # token de Hugging Face (Llama es un modelo con acceso restringido)

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
MAX_CONCURRENT_LLM_CALLS=32     # por proceso; excedente -> 503 con Retry-After
LLM_QUEUE_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- RAG
RETRIEVAL_TOP_K=4
MIN_RELEVANCE_SCORE=0.52        # calibrado con bge-m3 (tests/e2e/calibrate.py); por debajo: fuera de alcance
RETRIEVAL_SCORE_MARGIN=0.08     # solo documentos cercanos al mejor resultado
KB_REFRESH_SECONDS=30

# ---------------------------------------------------------------- Control de tokens
MAX_QUESTION_CHARS=1000
MAX_QUESTION_TOKENS=256
MAX_CONTEXT_TOKENS=2500
MAX_OUTPUT_TOKENS=512
TOKEN_BUDGET_PER_CLIENT_PER_DAY=100000

# ---------------------------------------------------------------- Caché
REDIS_MAXMEMORY=2gb
CACHE_TTL_SECONDS=86400
REFUSAL_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
EDGE_CACHE_MAX_AGE=3600         # s-maxage que la API anuncia al edge (Cloudflare)

# ---------------------------------------------------------------- Seguridad
RATE_LIMIT_PER_MINUTE=20
TRUST_PROXY_HEADERS=true        # true solo si el tráfico entra únicamente por nginx/Cloudflare
EDGE_SHARED_SECRET=             # si se define, la API exige el header X-Edge-Auth (lo agrega el Worker)
CORS_ALLOW_ORIGINS=             # ej.: https://mi.argentina.gob.ar
ALLOWED_LINK_DOMAINS=argentina.gob.ar,gob.ar
PROMPT_VERSION=v1               # cambiarlo invalida la caché de respuestas
